# SPDX-License-Identifier: MIT
# go-knx through a knxctl binary built from local sources (make goknx-local
# KNXCTL_DIR=../knxctl): for testing unreleased go-knx and knxctl changes.
ARG BASE_REGISTRY=docker.io/library
FROM ${BASE_REGISTRY}/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ARG TARGETARCH
COPY goknx/bin/knxctl-linux-${TARGETARCH} /usr/local/bin/knxctl
COPY common/ /adapter/common/
COPY goknx/adapter.py /adapter/run
RUN chmod +x /adapter/run /usr/local/bin/knxctl && /adapter/run capabilities
ENTRYPOINT ["/adapter/run"]
